<div class="row g-4">
  <div class="col-md-6">
    <img src="<%= product.image %>" class="img-fluid rounded" alt="<%= product.name %>">
  </div>
  <div class="col-md-6">
    <h1><%= product.name %></h1>
    <p class="text-muted"><%= product.category %></p>
    <p class="lead">$<%= product.price.toFixed(2) %></p>
    <p><%= product.description %></p>
    <form method="post" action="/cart/add" class="d-flex gap-2"><input type="hidden" name="id" value="<%= product.id %>"><input type="number" min="1" value="1" name="qty" class="form-control" style="max-width:100px"><button class="btn btn-success" type="submit">Add to Cart</button></form>
  </div>
</div>
